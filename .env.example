# UNISpaceX Environment Variables Configuration

# Database Connection (Default: SQLite for instant zero-dependency local dev; can be switched to PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/unispacex?schema=public"

# Authentication & Sessions
AUTH_SECRET="your-secure-jwt-auth-secret-key-at-least-32-chars-long"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Student Verification Provider (Options: 'mock' for local dev, 'sheerid' for official SheerID API)
VERIFICATION_MODE="mock"
SHEERID_API_KEY="your-sheerid-api-key"
SHEERID_CLIENT_ID="your-sheerid-program-or-client-id"

# Storage Configuration ('local', 'cloudinary', 's3')
STORAGE_PROVIDER="local"
STORAGE_BUCKET="unispace-uploads"

# Admin Initial Seed Account
ADMIN_EMAIL="admin@unispace.edu"
ADMIN_PASSWORD="AdminPassword123!"

# Default Campus Support WhatsApp
WHATSAPP_NUMBER="+15550192834"
